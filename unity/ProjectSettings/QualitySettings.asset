%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!47 &1
QualitySettings:
  m_ObjectHideFlags: 0
  serializedVersion: 14
  m_CurrentQuality: 2 # Default to HD
  m_QualitySettings:
  - e_name: "Smooth (60 FPS - Low End)"
    pixelLightCount: 1
    shadows: 0 # Disable real-time shadows for 60fps on budget chips
    shadowResolution: 0
    shadowProjection: 1
    shadowCascades: 1
    shadowDistance: 25
    shadowNearPlaneOffset: 3
    shadowCascade2Split: 0.33333334
    blendWeights: 1
    textureQuality: 1
    anisotropicTextures: 0
    antiAliasing: 0
    softParticles: 0
    softVegetation: 0
    realtimeReflectionProbes: 0
    billboardsFaceCameraPosition: 1
    vSyncCount: 0
    lodBias: 0.7
    maximumLODLevel: 0
    particleRaycastBudget: 64
    asyncUploadTimeSlice: 2
    asyncUploadBufferSize: 16
    resolutionScalingFixedDPIFactor: 0.8
  - e_name: "Balanced (60 FPS - Mid Range)"
    pixelLightCount: 2
    shadows: 1 # Hard shadows
    shadowResolution: 1
    shadowProjection: 1
    shadowCascades: 2
    shadowDistance: 50
    shadowNearPlaneOffset: 3
    shadowCascade2Split: 0.33333334
    blendWeights: 2
    textureQuality: 0
    anisotropicTextures: 1
    antiAliasing: 2
    softParticles: 1
    softVegetation: 1
    realtimeReflectionProbes: 0
    billboardsFaceCameraPosition: 1
    vSyncCount: 0
    lodBias: 1.0
    maximumLODLevel: 0
    particleRaycastBudget: 128
    asyncUploadTimeSlice: 2
    asyncUploadBufferSize: 32
    resolutionScalingFixedDPIFactor: 1.0
  - e_name: "HD (60 FPS - Recommended)"
    pixelLightCount: 4
    shadows: 2 # Soft shadows
    shadowResolution: 2
    shadowProjection: 1
    shadowCascades: 2
    shadowDistance: 75
    shadowNearPlaneOffset: 3
    shadowCascade2Split: 0.25
    blendWeights: 4
    textureQuality: 0
    anisotropicTextures: 1
    antiAliasing: 2
    softParticles: 1
    softVegetation: 1
    realtimeReflectionProbes: 1
    billboardsFaceCameraPosition: 1
    vSyncCount: 0
    lodBias: 1.3
    maximumLODLevel: 0
    particleRaycastBudget: 256
    asyncUploadTimeSlice: 4
    asyncUploadBufferSize: 64
    resolutionScalingFixedDPIFactor: 1.0
  - e_name: "HDR (60 FPS - High End)"
    pixelLightCount: 4
    shadows: 2
    shadowResolution: 2
    shadowProjection: 1
    shadowCascades: 4
    shadowDistance: 120
    shadowNearPlaneOffset: 3
    shadowCascade4Split: {x: 0.067, y: 0.2, z: 0.467}
    blendWeights: 4
    textureQuality: 0
    anisotropicTextures: 2
    antiAliasing: 4
    softParticles: 1
    softVegetation: 1
    realtimeReflectionProbes: 1
    billboardsFaceCameraPosition: 1
    vSyncCount: 0
    lodBias: 1.6
    maximumLODLevel: 0
    particleRaycastBudget: 512
    asyncUploadTimeSlice: 4
    asyncUploadBufferSize: 64
    resolutionScalingFixedDPIFactor: 1.0
  - e_name: "Ultra (90 FPS - Flagship)"
    pixelLightCount: 6
    shadows: 2
    shadowResolution: 3
    shadowProjection: 1
    shadowCascades: 4
    shadowDistance: 160
    shadowNearPlaneOffset: 3
    shadowCascade4Split: {x: 0.067, y: 0.2, z: 0.467}
    blendWeights: 4
    textureQuality: 0
    anisotropicTextures: 2
    antiAliasing: 4
    softParticles: 1
    softVegetation: 1
    realtimeReflectionProbes: 1
    billboardsFaceCameraPosition: 1
    vSyncCount: 0
    lodBias: 2.0
    maximumLODLevel: 0
    particleRaycastBudget: 1024
    asyncUploadTimeSlice: 8
    asyncUploadBufferSize: 128
    resolutionScalingFixedDPIFactor: 1.0
